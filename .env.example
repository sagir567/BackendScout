# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_BALANCED=gpt-5.6-terra
OPENAI_MODEL_HIGH_QUALITY=gpt-5.6-sol

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs, for example: 123456789
TELEGRAM_ALLOWED_USER_IDS=
# Optional. If omitted and there is exactly one allowed user ID, daily digests use it.
TELEGRAM_DEFAULT_CHAT_ID=

# Notion
NOTION_API_KEY=
NOTION_API_VERSION=2026-03-11
# Legacy test-tracker key. Keep only while migrating an existing setup.
NOTION_APPLICATIONS_DATA_SOURCE_ID=
# The default tracker used by commands without --tracker production.
NOTION_TEST_APPLICATIONS_DATA_SOURCE_ID=
# Required before a real application can be promoted or submitted.
NOTION_PRODUCTION_APPLICATIONS_DATA_SOURCE_ID=

# Local archive
CV_ARCHIVE_ROOT=TODO_ABSOLUTE_PATH_TO_PRIVATE_CV_ARCHIVE
# Optional when LibreOffice is installed outside the shell/launchd PATH.
LIBREOFFICE_EXECUTABLE=

# Gmail OAuth (private local path; refresh token is stored in macOS Keychain)
GMAIL_OAUTH_CLIENT_SECRET_PATH=
GMAIL_CREDENTIAL_STORE=keyring
# Linux cloud mode: set file and an absolute private path outside the checkout.
GMAIL_CREDENTIAL_FILE=

# Browser-assisted submissions
BROWSER_PROFILE_ROOT=TODO_ABSOLUTE_PATH_TO_PRIVATE_BROWSER_PROFILE
SUBMISSION_PROOF_ROOT=TODO_ABSOLUTE_PATH_TO_PRIVATE_SUBMISSION_PROOFS
# Uses the Mac's active Tailscale IP and a random port when available.
VERIFICATION_HANDOFF_ENABLED=true
VERIFICATION_HANDOFF_PORT=0
REMOTE_DESKTOP_INSTRUCTIONS=Open Chrome Remote Desktop on your phone and complete the human verification in the prepared browser.

# Private mobile workspace; never bind this server to a public/LAN interface.
WEB_HOST=127.0.0.1
WEB_PORT=8765
WEB_PUBLIC_ORIGIN=http://127.0.0.1:8765
# A private HTTPS proxy requires true and an exact https origin above.
WEB_COOKIE_SECURE=false
# Opt in only after testing the package worker and supported portal adapters.
WEB_ALLOW_DELIVERY=false

# Employer-first browser engine. Keep production on legacy until approved canaries.
PORTAL_DELIVERY_MODE=legacy
PORTAL_HYBRID_ROLLOUT=test
PORTAL_CANARY_APPLICATION_IDS=
PORTAL_RECEIPT_TIMEOUT_SECONDS=90
# Private JSON mapping model names to input_nis_per_million/output_nis_per_million.
# Without prices, deterministic forms still work; paid browser planning is paused.
PORTAL_AI_PRICES_PATH=
PORTAL_AI_MONTHLY_LIMIT_NIS=40
PORTAL_AI_APPLICATION_LIMIT_NIS=2
PROJECT_MONTHLY_LIMIT_NIS=100
PROJECT_FIXED_MONTHLY_NIS=0
PORTAL_MAX_MODEL_CALLS=6
PORTAL_MAX_ACTIONS=40
PORTAL_MAX_ACTIVE_SECONDS=600
