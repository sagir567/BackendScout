# Copy outside the checkout. chmod 0600. Never commit the filled-in file.
# This file supplies Compose interpolation, not a container env_file mount.
COMPOSE_PROJECT_NAME=backendscout
BACKENDSCOUT_PRIVATE_DIR=/srv/backendscout-private

# Both remain disabled until an owner-approved cutover. The automation profile
# alone is insufficient. Exact enabled values are documented in CLOUD_DEPLOYMENT.md.
BACKENDSCOUT_ENABLE_AUTOMATION=
BACKENDSCOUT_SCHEDULER_OWNERSHIP=

# Supply the currently approved model identifiers; no model/provider migration.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=
OPENAI_MODEL_BALANCED=
OPENAI_MODEL_HIGH_QUALITY=

NOTION_API_KEY=
NOTION_TEST_APPLICATIONS_DATA_SOURCE_ID=
NOTION_PRODUCTION_APPLICATIONS_DATA_SOURCE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Required for automation; blank is safe only while automation stays disabled.
TELEGRAM_DEFAULT_CHAT_ID=

# Fixed container paths in compose.yaml, not host paths. The refresh-token file
# must be writable for atomic refresh; the OAuth client mount is read-only.
GMAIL_CREDENTIAL_STORE=file
GMAIL_CREDENTIAL_FILE=/var/lib/backendscout/secrets/gmail.json
GMAIL_OAUTH_CLIENT_SECRET_PATH=/run/backendscout/secrets/gmail-client.json
